#!/bin/sh
# wmsk-launcher [drun|run|window] : rofi, with every app source (Flatpak, Snap, ...) on the search path so all installed
# apps show up. With wmodern's `wmapps` installed it asks that for the complete list; otherwise it adds Flatpak's.
command -v wmapps >/dev/null 2>&1 && exec wmapps launch "${1:-drun}"
for dir in /var/lib/flatpak/exports/share "$HOME/.local/share/flatpak/exports/share"; do
  [ -d "$dir" ] || continue
  case ":${XDG_DATA_DIRS:-}:" in *":$dir:"*) ;; *) XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:$dir" ;; esac
done
export XDG_DATA_DIRS
exec rofi -show "${1:-drun}"
